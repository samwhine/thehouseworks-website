# Copy this file to .env.local for local development, and set the same
# variable in your Vercel project settings for production.

# The site's canonical production URL — used for metadataBase, canonical
# links, sitemap.xml, robots.txt and JSON-LD. No trailing slash.
# We do not know the real domain yet, so this is a placeholder — replace it
# before going live. Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
